---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath, t } from '../i18n/ui';
import { profile } from '../lib/data';
---

<BaseLayout locale="en" title={`404 · ${profile.name}`} description={t('en', '404.text')} noindex>
  <section class="container not-found">
    <p class="code" aria-hidden="true">404</p>
    <div class="langs">
      <div lang="en">
        <h1>{t('en', '404.title')}</h1>
        <p>{t('en', '404.text')}</p>
        <p><a href={localizePath('/', 'en')}>{t('en', '404.back')}</a></p>
      </div>
      <div lang="pt-PT">
        <h2>{t('pt', '404.title')}</h2>
        <p>{t('pt', '404.text')}</p>
        <p><a href={localizePath('/', 'pt')}>{t('pt', '404.back')}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(56px, 12vw, 120px);
  }

  .code {
    font-size: clamp(4rem, 18vw, 9rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--accent);
  }

  .langs {
    display: grid;
    gap: 28px;
    margin-top: 28px;
  }

  .langs > div {
    display: grid;
    gap: 8px;
  }

  h1,
  h2 {
    font-size: 1.5rem;
  }

  .langs p {
    color: var(--fg-muted);
  }

  @media (min-width: 720px) {
    .langs {
      grid-template-columns: 1fr 1fr;
      max-width: 820px;
    }
  }
</style>
