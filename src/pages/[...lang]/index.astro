---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { langStaticPaths, localeFromParam, localized, t } from '../../i18n/ui';
import { profile, publicFileExists } from '../../lib/data';

export const getStaticPaths = langStaticPaths;

const locale = localeFromParam(Astro.params.lang);
const hasPhoto = publicFileExists(profile.photo);
// First name + last surname: "Bruno D. Ferreira-Saraiva" -> "BS".
const nameParts = profile.name.split(/[\s-]+/);
const initials = `${nameParts[0]?.[0] ?? ''}${nameParts.at(-1)?.[0] ?? ''}`;

const linkButtons = [
  { key: 'scholar', label: 'Google Scholar', icon: 'scholar', url: profile.links.scholar },
  { key: 'orcid', label: 'ORCID', icon: 'orcid', url: profile.links.orcid },
  { key: 'github', label: 'GitHub', icon: 'github', url: profile.links.github },
  { key: 'linkedin', label: 'LinkedIn', icon: 'linkedin', url: profile.links.linkedin },
  { key: 'institutional', label: 'Lusófona', icon: 'building', url: profile.links.institutional },
] as const;
---

<BaseLayout locale={locale} title={`${profile.name} — ${localized(profile.role, locale)}`} active="home">
  <section class="container hero">
    <figure class="portrait">
      {
        hasPhoto ? (
          <img src={profile.photo} alt={t(locale, 'home.photoAlt', { name: profile.name })} width="512" height="512" />
        ) : (
          <div class="monogram" aria-hidden="true">
            {initials}
          </div>
        )
      }
    </figure>

    <div class="intro">
      <h1 class="name">{profile.name}</h1>
      <p class="role">
        {localized(profile.role, locale)}
        <span class="sep" aria-hidden="true">·</span>
        {localized(profile.affiliation, locale)}
      </p>

      <div class="bio">
        {profile.bio.map((paragraph) => <p>{localized(paragraph, locale)}</p>)}
      </div>

      <ul class="links" aria-label={t(locale, 'home.links')}>
        {
          linkButtons
            .filter((link) => link.url)
            .map((link) => (
              <li>
                <a class="link-btn" href={link.url} rel="me noopener">
                  <Icon name={link.icon} size={15} />
                  <span>{link.label}</span>
                </a>
              </li>
            ))
        }
        {
          profile.email && (
            <li>
              <a class="link-btn" href="#" data-mail-user={profile.email.user} data-mail-domain={profile.email.domain}>
                <Icon name="mail" size={15} />
                <span>Email</span>
              </a>
            </li>
          )
        }
      </ul>
      {
        profile.email && (
          <noscript>
            <p class="noscript-email">
              {profile.email.user} [at] {profile.email.domain}
            </p>
          </noscript>
        )
      }
    </div>
  </section>

  <section class="container block" aria-labelledby="interests-title">
    <h2 class="section-label" id="interests-title">{t(locale, 'home.interests')}</h2>
    <ul class="interests">
      {profile.interests.map((interest) => <li class="chip">{localized(interest, locale)}</li>)}
    </ul>
  </section>
</BaseLayout>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-mail-user]')) {
    link.href = `mailto:${link.dataset.mailUser}@${link.dataset.mailDomain}`;
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 32px;
    padding-block: clamp(40px, 8vw, 88px) 40px;
  }

  .name {
    font-size: clamp(2rem, 5vw, 2.9rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .role {
    margin-top: 10px;
    font-size: 1.0625rem;
    color: var(--fg-muted);
  }

  .role .sep {
    margin-inline: 6px;
    color: var(--fg-faint);
  }

  .bio {
    display: grid;
    gap: 14px;
    max-width: 66ch;
    margin-top: 24px;
    font-size: 1.0625rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elev);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .link-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .noscript-email {
    margin-top: 10px;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  /* The source photo is already round: show it as a circle so the grey corners disappear. */
  .portrait {
    margin: 0;
    width: clamp(140px, 30vw, 220px);
  }

  .portrait img,
  .monogram {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
    box-shadow: 0 0 0 6px var(--bg-elev), 0 0 0 7px var(--border);
  }

  .monogram {
    display: grid;
    place-items: center;
    background: var(--bg-sunken);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 600;
    color: var(--accent);
  }

  .block {
    padding-bottom: 48px;
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .interests .chip {
    font-size: 0.875rem;
    color: var(--fg);
  }

  @media (min-width: 860px) {
    .hero {
      grid-template-columns: 220px 1fr;
      align-items: start;
      gap: 56px;
    }

    .portrait {
      margin-top: 8px;
    }
  }
</style>
