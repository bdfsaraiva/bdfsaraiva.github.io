---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { langStaticPaths, localeFromParam, localizePath, localized, t } from '../../i18n/ui';
import { profile, publicFileExists } from '../../lib/data';

export const getStaticPaths = langStaticPaths;

const locale = localeFromParam(Astro.params.lang);
const hasPhoto = publicFileExists(profile.photo);
// First name + last surname: "Bruno D. Ferreira-Saraiva" -> "BS".
const nameParts = profile.name.split(/[\s-]+/);
const initials = `${nameParts[0]?.[0] ?? ''}${nameParts.at(-1)?.[0] ?? ''}`;

const profileLinks = [
  { label: 'Google Scholar', icon: 'scholar', url: profile.links.scholar },
  { label: 'ORCID', icon: 'orcid', url: profile.links.orcid },
  { label: 'GitHub', icon: 'github', url: profile.links.github },
  { label: 'LinkedIn', icon: 'linkedin', url: profile.links.linkedin },
  { label: 'Lusófona', icon: 'building', url: profile.links.institutional },
] as const;
---

<BaseLayout locale={locale} title={`${profile.name} — ${localized(profile.role, locale)}`} active="home">
  <section class="container hero">
    <figure class="portrait">
      {
        hasPhoto ? (
          <img src={profile.photo} alt={t(locale, 'home.photoAlt', { name: profile.name })} width="512" height="512" />
        ) : (
          <div class="monogram" aria-hidden="true">
            {initials}
          </div>
        )
      }
    </figure>

    <div class="intro">
      <h1 class="name">{profile.name}</h1>
      <p class="role">
        {localized(profile.role, locale)}
        <span class="sep" aria-hidden="true">·</span>
        {localized(profile.affiliation, locale)}
      </p>

      <!-- Contact first: one primary action, the profiles as quiet links. -->
      <div class="contact">
        {
          profile.email && (
            <a class="email-btn" href="#" data-mail-user={profile.email.user} data-mail-domain={profile.email.domain}>
              <Icon name="mail" size={16} />
              <span>{t(locale, 'home.email')}</span>
            </a>
          )
        }
        <ul class="profile-links" aria-label={t(locale, 'home.links')}>
          {
            profileLinks
              .filter((link) => link.url)
              .map((link) => (
                <li>
                  <a href={link.url} rel="me noopener">
                    <Icon name={link.icon} size={15} />
                    {link.label}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>
      {
        profile.email && (
          <noscript>
            <p class="noscript-email">
              {profile.email.user} [at] {profile.email.domain}
            </p>
          </noscript>
        )
      }
    </div>
  </section>

  <!-- Bio and selected work side by side on wide screens, so the evidence is visible without scrolling. -->
  <div class="container lead">
    <div class="bio">
      {profile.bio.map((paragraph) => <p>{localized(paragraph, locale)}</p>)}
    </div>

    {
      profile.featured && profile.featured.length > 0 && (
        <section class="featured-block" aria-labelledby="featured-title">
          <h2 class="section-label" id="featured-title">
            {t(locale, 'home.featured')}
          </h2>
          <ul class="featured">
            {profile.featured.map((item) => (
              <li>
                <a href={item.path ? localizePath(item.path, locale) : item.url}>{item.title}</a>
                <p>{localized(item.meta, locale)}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <section class="container block" aria-labelledby="interests-title">
    <h2 class="section-label" id="interests-title">{t(locale, 'home.interests')}</h2>
    <ul class="interests">
      {profile.interests.map((interest) => <li class="chip">{localized(interest, locale)}</li>)}
    </ul>
  </section>
</BaseLayout>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-mail-user]')) {
    link.href = `mailto:${link.dataset.mailUser}@${link.dataset.mailDomain}`;
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 28px;
    padding-block: clamp(40px, 7vw, 72px) 40px;
  }

  .name {
    font-size: clamp(2.25rem, 5.5vw, 3.25rem);
    line-height: 1.08;
  }

  .role {
    margin-top: 10px;
    font-size: 1.0625rem;
    color: var(--fg-muted);
  }

  .role .sep {
    margin-inline: 6px;
    color: var(--fg-faint);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 24px;
  }

  .email-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-fg);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .email-btn:hover {
    background: var(--accent-strong);
    color: var(--accent-fg);
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }

  .profile-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .profile-links a:hover {
    color: var(--accent);
  }

  .noscript-email {
    margin-top: 10px;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .lead {
    display: grid;
    gap: 40px;
    padding-bottom: 48px;
  }

  .bio {
    display: grid;
    gap: 14px;
    max-width: 62ch;
    font-size: 1.0625rem;
  }

  /* The first paragraph is the summary; the rest is detail. */
  .bio p:first-child {
    font-size: 1.1875rem;
    line-height: 1.55;
  }

  .featured-block {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  /* The source photo is already round: show it as a circle so the grey corners disappear. */
  .portrait {
    margin: 0;
    width: clamp(140px, 30vw, 220px);
  }

  .portrait img,
  .monogram {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .monogram {
    display: grid;
    place-items: center;
    background: var(--bg-sunken);
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 600;
    color: var(--accent);
  }

  .block {
    display: grid;
    gap: 16px;
    padding-bottom: 48px;
  }

  .featured {
    display: grid;
    max-width: 72ch;
  }

  .featured li {
    padding-block: 12px;
    border-top: 1px solid var(--border);
  }

  .featured li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .featured a {
    display: inline-block;
    padding-block: 4px;
    font-weight: 600;
    text-decoration: none;
  }

  .featured a:hover {
    text-decoration: underline;
  }

  .featured p {
    margin-top: 2px;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .interests .chip {
    font-size: 0.875rem;
    color: var(--fg);
  }

  @media (min-width: 860px) {
    .hero {
      grid-template-columns: 220px 1fr;
      align-items: center;
      gap: 56px;
    }

    .portrait {
      margin-top: 8px;
    }
  }

  @media (min-width: 960px) {
    .lead {
      grid-template-columns: minmax(0, 62ch) minmax(260px, 1fr);
      gap: 56px;
    }
  }
</style>
