---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langStaticPaths, localeFromParam, localized, t } from '../../i18n/ui';
import { courses, isCurrentCourse, profile, programmes } from '../../lib/data';
import type { Course, CourseLevel } from '../../lib/types';

export const getStaticPaths = langStaticPaths;

const locale = localeFromParam(Astro.params.lang);

// One section per degree level; courses keep the order written in courses.yaml.
const LEVELS: CourseLevel[] = ['bsc', 'msc', 'postgrad'];
const sections = LEVELS.map((level) => {
  const items = courses.filter((course) => course.level === level);
  // Acronyms used in this section, in order of first appearance, for the one-line key.
  const acronyms = [...new Set(items.flatMap((course) => course.programmes ?? []))].filter((code) => programmes[code]?.acronym);
  return { level, items, acronyms };
}).filter((section) => section.items.length > 0);

/** "2019 – present", "2019 – 2023" or just "2023" for a single year. */
function period(course: Course): string {
  if (course.to == null) return `${course.from} – ${t(locale, 'teaching.present')}`;
  return course.to === course.from ? String(course.from) : `${course.from} – ${course.to}`;
}
---

<BaseLayout locale={locale} title={`${t(locale, 'teaching.title')} · ${profile.name}`} description={t(locale, 'teaching.description')} active="teaching">
  <header class="container page-head">
    <h1>{t(locale, 'teaching.title')}</h1>
    <p class="lede">{t(locale, 'teaching.intro')}</p>
  </header>

  {
    sections.map((section) => (
      <section class={`container stack-section level-${section.level}`} aria-labelledby={`level-${section.level}`}>
        <div class="level-head">
          <h2 class="section-label level-title" id={`level-${section.level}`}>
            {t(locale, `teaching.level.${section.level}`)}
          </h2>
          {section.acronyms.length > 0 && (
            <p class="legend">
              {section.acronyms.map((code, i) => (
                <span>
                  {i > 0 && ' · '}
                  <b>{code}</b> {localized(programmes[code].name, locale)}
                </span>
              ))}
            </p>
          )}
        </div>

        <ul class="courses">
          {section.items.map((course) => {
            const current = isCurrentCourse(course);
            return (
              <li class:list={['course', { past: !current }]}>
                <div class="course-main">
                  <h3>{localized(course.name, locale)}</h3>
                  <p class="course-meta">
                    {course.programmes && course.programmes.length > 0 && (
                      <span class="programmes">
                        {course.programmes.map((code, i) => {
                          const programme = programmes[code];
                          return (
                            <>
                              {i > 0 && ' · '}
                              {/* The title only shows on hover, so screen readers also get the full name. */}
                              {programme?.acronym ? (
                                <abbr title={localized(programme.name, locale)}>
                                  <span aria-hidden="true">{code}</span>
                                  <span class="visually-hidden">{localized(programme.name, locale)}</span>
                                </abbr>
                              ) : programme ? (
                                localized(programme.name, locale)
                              ) : (
                                code
                              )}
                            </>
                          );
                        })}
                      </span>
                    )}
                    <span class="num">{period(course)}</span>
                    {course.role && <span>{localized(course.role, locale)}</span>}
                  </p>
                </div>
                <div class="course-side">
                  {!current && <span class="past-tag">{t(locale, 'teaching.past')}</span>}
                  {course.syllabus && (
                    <a class="syllabus" href={course.syllabus}>
                      {t(locale, 'teaching.syllabus')}
                    </a>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  /* Each degree level has its own colour: BSc the site accent, MSc violet, postgraduate amber. */
  .level-bsc {
    --level: var(--accent);
  }

  .level-msc {
    --level: var(--msc);
  }

  .level-postgrad {
    --level: var(--pg);
  }

  .level-head {
    display: grid;
    gap: 6px;
  }

  .level-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .level-title::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--level);
  }

  /* One-line key for the programme acronyms used in the section. */
  .legend {
    max-width: 75ch;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--fg-muted);
  }

  .legend b {
    font-weight: 600;
    color: var(--fg);
  }

  .courses {
    border-top: 1px solid var(--border);
  }

  .course {
    display: grid;
    gap: 6px 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--border);
  }

  .course h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .course-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
    margin-top: 4px;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  /* The dot trails the previous item, so a wrapped line never starts with a separator. */
  .course-meta > span:not(:last-child)::after {
    content: '·';
    margin-inline: 8px;
    color: var(--fg-faint);
  }

  .programmes abbr {
    text-decoration: none;
    cursor: help;
  }

  /* Courses no longer taught recede; current ones keep full contrast. */
  .past h3 {
    color: var(--fg-muted);
    font-weight: 500;
  }

  .course-side {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }

  /* Only the exceptions are marked: most courses are current, so a "current" badge would say nothing. */
  .past-tag {
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .syllabus {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
  }

  @media (min-width: 760px) {
    .course {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .course-side {
      justify-content: flex-end;
    }
  }
</style>
