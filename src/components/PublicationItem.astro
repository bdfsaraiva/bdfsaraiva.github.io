---
import Icon from './Icon.astro';
import { localized, t, type Locale } from '../i18n/ui';
import type { PubAuthor, Publication } from '../lib/types';

interface Props {
  pub: Publication;
  locale: Locale;
}

const { pub, locale } = Astro.props;

/** Long author lists are shortened, but the site owner always stays visible. */
function shortenAuthors(authors: PubAuthor[], keep = 6): (PubAuthor | '…')[] {
  if (authors.length <= keep + 3) return authors;
  const head: (PubAuthor | '…')[] = authors.slice(0, keep);
  const meIndex = authors.findIndex((a) => a.me);
  if (meIndex >= keep) head.push('…', authors[meIndex]);
  return head;
}

const shown = shortenAuthors(pub.authors);
const hidden = pub.authors.length - shown.filter((a) => a !== '…').length;
const linkOrder = ['doi', 'pdf', 'preprint', 'code', 'data', 'slides', 'url'] as const;
const links = linkOrder.filter((key) => pub.links[key]).map((key) => ({ key, url: pub.links[key]! }));
const bibId = `bib-${pub.id}`;
const citationsKey = pub.citations === 1 ? 'pubs.citations.one' : 'pubs.citations.other';
---

<li class="pub" data-type={pub.type}>
  <p class="meta mono">
    <span class={`badge badge-${pub.type}`}>{t(locale, `pubs.type.${pub.type}`)}</span>
    {
      pub.award && (
        <span class="award">
          <Icon name="star" size={11} />
          {localized(pub.award, locale)}
        </span>
      )
    }
    {pub.venue && <span class="venue">{pub.venue}</span>}
    {pub.note && <span class="note">{localized(pub.note, locale)}</span>}
    {pub.citations > 0 && <span class="citations">{t(locale, citationsKey, { n: pub.citations })}</span>}
  </p>

  <h4 class="title">
    {pub.links.doi || pub.links.url ? <a href={pub.links.doi ?? pub.links.url}>{pub.title}</a> : pub.title}
  </h4>

  <!-- Kept on one line: line breaks inside the map would render as spaces before the commas. -->
  <p class="authors" hidden={pub.authors.length === 0}>
    {shown.map((author, i) => <>{i > 0 && ', '}{author === '…' ? '…' : author.me ? <strong>{author.name}</strong> : author.name}</>)}
    {hidden > 0 && <span class="et-al"> {t(locale, 'pubs.etAl')} (+{hidden})</span>}
  </p>

  <div class="bracket-links actions">
    {links.map((link) => <a href={link.url}>{t(locale, `pubs.link.${link.key}`)}</a>)}
    {
      pub.bibtex && (
        <button type="button" data-bibtex={bibId} data-copied={t(locale, 'pubs.copied')} data-failed={t(locale, 'pubs.copyFailed')}>{t(locale, 'pubs.bibtex')}</button>
      )
    }
  </div>

  {
    pub.abstract && (
      <details class="abstract">
        <summary class="mono">{t(locale, 'pubs.abstract')}</summary>
        <p>{pub.abstract}</p>
      </details>
    )
  }

  {pub.bibtex && <pre class="bibtex mono" id={bibId} hidden>{pub.bibtex}</pre>}
</li>

<style>
  .pub {
    display: grid;
    gap: 6px;
    padding: 18px 0 20px;
    border-bottom: 1px dashed var(--border);
  }

  .pub:last-child {
    border-bottom: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .venue {
    font-style: italic;
  }

  /* Distinctions (e.g. a best poster award) use the amber accent of the palette. */
  .award {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 1px 8px;
    border: 1px solid color-mix(in srgb, var(--pg) 55%, transparent);
    border-radius: 4px;
    background: var(--pg-soft);
    color: var(--pg);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .note::before {
    content: '· ';
    color: var(--fg-faint);
  }

  .citations::before {
    content: '↳ ';
    color: var(--fg-faint);
  }

  .badge {
    padding: 1px 8px;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .badge-journal,
  .badge-conference,
  .badge-software {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
  }

  .authors {
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .authors strong {
    color: var(--fg);
    font-weight: 600;
  }

  .et-al {
    color: var(--fg-faint);
  }

  .actions {
    margin-top: 4px;
  }

  .abstract summary {
    width: fit-content;
    font-size: 0.8125rem;
    color: var(--fg-muted);
    cursor: pointer;
  }

  .abstract summary:hover {
    color: var(--accent);
  }

  .abstract p {
    margin-top: 8px;
    padding-left: 14px;
    border-left: 2px solid var(--accent-soft);
    max-width: 75ch;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .bibtex {
    margin: 6px 0 0;
    padding: 14px;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-sunken);
    font-size: 0.75rem;
    line-height: 1.55;
    white-space: pre;
  }
</style>
