---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { htmlLang, t, type Locale } from '../i18n/ui';
import type { NavKey } from '../lib/types';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  active?: NavKey;
  noindex?: boolean;
}

const { locale, title, description = t(locale, 'meta.description'), active, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121417" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply a saved theme before first paint to avoid a flash of the wrong colours.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <Seo locale={locale} title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'nav.skip')}</a>
    <SiteHeader locale={locale} active={active} showLangSwitch={!noindex} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
